    {
      "id": "ccc7c64be09e",
      "doc_id": "news/budget_2025.md",
      "chunk_id": "news/budget_2025.md#0",
      "text": "# Riverton sets its 2025 works budget"
    },
    {
      "id": "5fdeda143df3",
      "doc_id": "news/budget_2025.md",
      "chunk_id": "news/budget_2025.md#0",
      "text": "- Mill Lane footbridge repair: 180,000 pounds"
    },
    {
      "id": "f8bf11e1ffbd",
      "doc_id": "news/budget_2025.md",
      "chunk_id": "news/budget_2025.md#0",
      "text": "- Harbour Street resurfacing: 95,000 pounds"
    },
    {
      "id": "6db463e1c631",
      "doc_id": "news/budget_2026.md",
      "chunk_id": "news/budget_2026.md#0",
      "text": "- Riverside path lighting: 230,000 pounds"
    },
    {
      "id": "75d8459634ca",
      "doc_id": "news/budget_2026.md",
      "chunk_id": "news/budget_2026.md#0",
      "text": "- Mill Lane footbridge east railing: 15,000 pounds"
    },
    {
      "id": "28f2481f2df9",
      "doc_id": "news/budget_2026.md",
      "chunk_id": "news/budget_2026.md#0",
      "text": "Councillor Priya Nandakumar welcomed the second drainage phase but asked why the resurfacing had slipped by a year."
    },
    {
      "id": "4aa22b3f7a5a",
      "doc_id": "news/council_notices.md",
      "chunk_id": "news/council_notices.md#0",
      "text": "Mill Lane footbridge: closed to all users from 3 February for repair works, for about eight weeks."
    },
    {
      "id": "29f78d3a0f72",
      "doc_id": "news/council_notices.md",
      "chunk_id": "news/council_notices.md#0",
      "text": "Harbour Street: resurfacing postponed to 2026."
    },
    {
      "id": "05f5e940c51f",
      "doc_id": "news/council_notices.md",
      "chunk_id": "news/council_notices.md#0",
      "text": "The street stays open to traffic."
    },
    {
      "id": "dc9054227c1b",
      "doc_id": "news/flood_meeting.md",
      "chunk_id": "news/flood_meeting.md#0",
      "text": "The council's structural inspector, Daniel Okafor, said the culvert under Station Road is too narrow for heavy storms."
    },
    {
      "id": "a328b6014180",
      "doc_id": "news/footbridge_reopens.md",
      "chunk_id": "news/footbridge_reopens.md#0",
      "text": "# Mill Lane footbridge reopens"
    },
    {
      "id": "f4ace719d784",
      "doc_id": "news/footbridge_reopens.md",
      "chunk_id": "news/footbridge_reopens.md#0",
      "text": "The Mill Lane footbridge reopened on 28 March after eight weeks of works."
    },
    {
      "id": "13ccb42ae910",
      "doc_id": "news/harbour_open_day.md",
      "chunk_id": "news/harbour_open_day.md#0",
      "text": "# Riverton Water opens its doors"
    },
    {
      "id": "eeb4128ff7b9",
      "doc_id": "news/harbour_open_day.md",
      "chunk_id": "news/harbour_open_day.md#0",
      "text": "Technician Rosa Delgado showed them the station's Kestrel V-12 pump and explained how the alarms reach North Station when the site is unmanned."
    },
    {
      "id": "e063b1980590",
      "doc_id": "news/harbour_open_day.md",
      "chunk_id": "news/harbour_open_day.md#0",
      "text": "Children could try a hand pump in the yard, and the café sold out of cakes by noon."
    },
    {
      "id": "6c30b0539e20",
      "doc_id": "news/library_reopened.md",
      "chunk_id": "news/library_reopened.md#0",
      "text": "# Eastgate library back in business"
    },
    {
      "id": "972dc04c241d",
      "doc_id": "news/mill_lane_and_eastgate.md",
      "chunk_id": "news/mill_lane_and_eastgate.md#0",
      "text": "The footbridge will be closed from 3 February while its railings and deck boards are renewed."
    },
    {
      "id": "32db2c49ec43",
      "doc_id": "water/calder_quotation.md",
      "chunk_id": "water/calder_quotation.md#0",
      "text": "Dear Riverton Water,"
    },
    {
      "id": "896fb5916255",
      "doc_id": "water/calder_quotation.md",
      "chunk_id": "water/calder_quotation.md#0",
      "text": "In our experience a Hydra P-40 needs a new mechanical seal every 18 months of duty."
    },
    {
      "id": "db2c95d2b0c9",
      "doc_id": "water/calder_quotation.md",
      "chunk_id": "water/calder_quotation.md#0",
      "text": "Kind regards,"
    },
    {
      "id": "a0a2c56a7f23",
      "doc_id": "water/harbour_station_may_2025.md",
      "chunk_id": "water/harbour_station_may_2025.md#0",
      "text": "The station's only pump, KV12-0457, tripped three times in the first week of May on low suction pressure."
