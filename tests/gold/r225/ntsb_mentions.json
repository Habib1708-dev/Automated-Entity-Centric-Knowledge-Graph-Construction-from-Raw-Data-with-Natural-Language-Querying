          "kind": "kind"
        },
        {
          "name": "nosewheel",
          "kind": "kind"
        },
        {
          "name": "collapsed",
          "kind": "kind"
        }
      ],
      "note": ""
    },
    {
      "id": "fda8688d99e4",
      "doc_id": "documents/beech_a36_accidents.md",
      "text": "While at an altitude of 8,000 ft mean sea level, the pilot noticed the engine oil pressure began to fluctuate.",
      "mentions": [
        {
          "name": "pilot",
          "kind": "kind"
        },
        {
