    {
      "id": "471eb5bb0e37",
      "doc_id": "documents/air_tractor_at_502b_accidents.md",
      "text": "Damage to the propeller blades was consistent with high impact forces while the propeller was rotating at low power at a low blade pitch angle.",
      "mentions": [
