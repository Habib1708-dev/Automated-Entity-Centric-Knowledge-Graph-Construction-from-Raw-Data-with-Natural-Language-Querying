    },
    {
      "id": "01090ca16316",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "As he applied the brakes, the airplane began to hydroplane, so he released braking pressure to regain directional control.",
      "mentions": [
        {
          "name": "brakes",
          "kind": "kind"
        },
        {
          "name": "airplane",
          "kind": "kind"
        },
        {
