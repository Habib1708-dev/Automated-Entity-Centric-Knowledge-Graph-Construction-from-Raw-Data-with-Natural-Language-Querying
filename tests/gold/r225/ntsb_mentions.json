    {
      "id": "ccc9d3df4908",
      "doc_id": "documents/air_tractor_at_502b_accidents.md",
      "text": "Examination revealed that all compressor turbine (CT) rotor blades were fractured at varying spanwise locations.",
      "mentions": [
