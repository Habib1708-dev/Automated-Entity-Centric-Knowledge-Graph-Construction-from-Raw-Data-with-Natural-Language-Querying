    },
    {
      "id": "8bfd17e2bbff",
      "doc_id": "documents/beech_a36_accidents.md",
      "text": "The pilot attempted to restore engine power by switching to the right fuel tank and activating the starter but was unsuccessful.",
      "mentions": [
        {
          "name": "pilot",
          "kind": "kind"
        },
        {
          "name": "engine power",
