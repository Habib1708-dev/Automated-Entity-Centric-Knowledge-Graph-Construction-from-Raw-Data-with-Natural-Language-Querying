    },
    {
      "id": "54a8e3393257",
      "doc_id": "documents/cessna_172s_accidents.md",
      "text": "Examination of the engine and fuel system revealed a loose “B” nut fitting on the fuel line between the fuel injector and fuel manifold.",
      "mentions": [
