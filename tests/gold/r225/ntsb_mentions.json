    {
      "id": "b3fb9cee89e4",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "Probable cause: An inflight instrument malfunction for reasons that could not be determined based on available information, which led to the pilot’s decision to activate the airframe parachute system.",
      "mentions": [
        {
          "name": "instrument malfunction",
          "kind": "kind"
        },
        {
          "name": "pilot",
          "kind": "kind"
        },
        {
          "name": "airframe parachute system",
          "kind": "kind"
        }
      ],
      "note": "'inflight' dropped as a describing word; the decision is an everyday act (Out 8)."
    },
    {
      "id": "94f7c28c257a",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "The airplane bounced onto the runway, so the pilot elected to do a go-around.",
      "mentions": [
        {
          "name": "airplane",
          "kind": "kind"
        },
        {
          "name": "bounced",
          "kind": "kind"
        },
        {
