          "name": "pilot",
          "kind": "kind"
        },
        {
          "name": "go-around",
          "kind": "kind"
        }
      ],
      "note": ""
    },
    {
      "id": "f1d4b51e1ae4",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "About the time of the accident, the automated weather reporting station located 23 miles northwest of the accident site reported, wind from 290° at 10 kts gusting to 21 kts.",
      "mentions": [
        {
          "name": "accident",
          "kind": "kind"
        },
        {
          "name": "automated weather reporting station",
          "kind": "kind"
        },
        {
          "name": "accident site",
          "kind": "kind"
        },
        {
          "name": "wind",
          "kind": "kind"
        },
        {
          "name": "gusting",
          "kind": "kind"
        }
      ],
      "note": "Distances, directions and speeds are quantities (Out 4)."
    },
    {
      "id": "b94e94325e16",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "The pilot reported that he landed on a runway that was wet due to recent rain showers.",
      "mentions": [
        {
          "name": "pilot",
