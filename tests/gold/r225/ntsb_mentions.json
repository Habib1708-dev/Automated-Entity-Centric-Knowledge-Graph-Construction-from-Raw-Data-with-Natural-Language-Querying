        },
        {
          "name": "braking pressure",
          "kind": "kind"
        },
        {
          "name": "directional control",
          "kind": "kind"
        }
      ],
      "note": ""
    },
    {
      "id": "728e74752005",
      "doc_id": "documents/cirrus_sr22_accidents.md",
      "text": "The pilot then reapplied the brakes but was unable to stop the airplane on the remaining runway.",
      "mentions": [
        {
          "name": "pilot",
