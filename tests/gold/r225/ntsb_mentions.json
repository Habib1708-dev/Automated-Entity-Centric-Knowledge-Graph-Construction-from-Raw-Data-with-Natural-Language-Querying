    },
    {
      "id": "beaa10cfaef8",
      "doc_id": "documents/beech_a36_accidents.md",
      "text": "An initial inspection of the airplane noted damage to the airplane’s wings and fuselage.",
      "mentions": [
        {
          "name": "inspection",
          "kind": "kind"
