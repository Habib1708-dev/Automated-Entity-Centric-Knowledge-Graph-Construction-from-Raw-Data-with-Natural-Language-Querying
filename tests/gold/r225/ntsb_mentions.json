    },
    {
      "id": "1fac0fbdcab6",
      "doc_id": "documents/beech_a36_accidents.md",
      "text": "The data did not illustrate any abnormalities with either the cylinder head temperature or exhaust gas temperatures that were recorded; the total loss of power was evident.",
      "mentions": [
