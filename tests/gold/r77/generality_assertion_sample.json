 "sentences": [
  {
   "id": "02d1fff0c674",
   "doc_id": "institute/brackwater_fen_log.txt",
   "chunk_id": "institute/brackwater_fen_log.txt#0",
   "text": "Brackwater fen field log, spring 2025, kept by S.",
   "stratum": "natural"
  },
  {
   "id": "d8af3db3d603",
   "doc_id": "institute/brackwater_fen_log.txt",
   "chunk_id": "institute/brackwater_fen_log.txt#0",
   "text": "Core BF-4, 22 April: not taken, the corer had been lent to the Aldmoor team.",
   "stratum": "cue"
  },
  {
   "id": "cd5cad01c2f6",
   "doc_id": "institute/fieldwork_log.txt",
   "chunk_id": "institute/fieldwork_log.txt#0",
   "text": "Samuel Osei joined the trip on 10 December to learn the coring method.",
   "stratum": "natural"
  },
  {
   "id": "1307dda5808a",
   "doc_id": "institute/flume_commissioning.md",
   "chunk_id": "institute/flume_commissioning.md#0",
   "text": "Sand was fed at the upstream end and the bed formed ripples within an hour.",
   "stratum": "natural"
  },
  {
   "id": "4bc7a2156be5",
   "doc_id": "institute/flume_commissioning.md",
   "chunk_id": "institute/flume_commissioning.md#0",
   "text": "No run went above 60 litres per second in May: the committee had asked for a vibration measurement first.",
   "stratum": "cue"
  },
  {
   "id": "8ad2d56e2991",
   "doc_id": "institute/hensley_award.md",
   "chunk_id": "institute/hensley_award.md#0",
   "text": "The institute gives the Hensley Field-Work Award once a year for outstanding field work.",
   "stratum": "cue"
  },
  {
   "id": "432e5ab6208f",
   "doc_id": "institute/hensley_award.md",
   "chunk_id": "institute/hensley_award.md#0",
   "text": "Samuel Osei was nominated, but the committee found that no entry met the standard.",
   "stratum": "cue"
  },
  {
   "id": "15ed485510ed",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "# Minutes of the institute committee, 12 May 2025",
   "stratum": "natural"
  },
  {
   "id": "beafb8b503ba",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "Present: Jon Pike (chair), Maria Lopez (Finance Office), Aiko Tanaka, Samuel Osei.",
   "stratum": "cue"
  },
  {
   "id": "dd94a04b8fa3",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "Maria Lopez presented the grants budget for 2025-26.",
   "stratum": "natural"
  },
  {
   "id": "36eaac0d87ce",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "Every project lead must submit a data management plan by 30 June 2025.",
   "stratum": "cue"
  },
  {
   "id": "de614a33c49b",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "Projects without a plan will not receive second-year funding.",
   "stratum": "cue"
  },
  {
   "id": "519af76b9c96",
   "doc_id": "institute/minutes_2025-05-12.md",
   "chunk_id": "institute/minutes_2025-05-12.md#0",
   "text": "Samuel Osei will measure the vibration before any experiment runs above 60 litres per second.",
   "stratum": "natural"
  },
  {
   "id": "8626be5fa7b3",
   "doc_id": "institute/minutes_2025-06-09.md",
   "chunk_id": "institute/minutes_2025-06-09.md#0",
   "text": "# Minutes of the institute committee, 9 June 2025",
   "stratum": "natural"
  },
  {
   "id": "7c29c26963f3",
   "doc_id": "institute/minutes_2025-06-09.md",
   "chunk_id": "institute/minutes_2025-06-09.md#0",
   "text": "Pike explained the equipment overrun of the Aldmoor peat project: a second corer had to be bought after the first one jammed in December.",
   "stratum": "cue"
  },
  {
   "id": "fe23e269344f",
   "doc_id": "institute/minutes_2025-06-09.md",
   "chunk_id": "institute/minutes_2025-06-09.md#0",
   "text": "Aiko Tanaka closed the meeting at 15:55.",
   "stratum": "natural"
  },
  {
   "id": "a32a15b8728d",
   "doc_id": "institute/newsletter_spring_2025.md",
   "chunk_id": "institute/newsletter_spring_2025.md#0",
   "text": "## Field-work award",
   "stratum": "natural"
  },
  {
   "id": "0fd20529e67f",
   "doc_id": "institute/newsletter_spring_2025.md",
   "chunk_id": "institute/newsletter_spring_2025.md#0",
   "text": "## New hydrology flume",
   "stratum": "natural"
  },
  {
   "id": "d91d59572bd9",
   "doc_id": "institute/newsletter_spring_2025.md",
   "chunk_id": "institute/newsletter_spring_2025.md#0",
   "text": "The Hydrology team, led by research engineer Aiko Tanaka, has finished building a 12-metre sediment flume in the basement laboratory.",
   "stratum": "cue"
  },
  {
   "id": "f425dcdd0871",
   "doc_id": "institute/newsletter_spring_2025.md",
   "chunk_id": "institute/newsletter_spring_2025.md#0",
   "text": "The first experiments start in May.",
   "stratum": "cue"
  },
  {
   "id": "4647469df773",
   "doc_id": "institute/travel_claims_memo.md",
   "chunk_id": "institute/travel_claims_memo.md#0",
   "text": "From: Maria Lopez, grants accountant",
   "stratum": "cue"
  },
  {
   "id": "3350e8f842ad",
   "doc_id": "institute/travel_claims_memo.md",
   "chunk_id": "institute/travel_claims_memo.md#0",
   "text": "Travel claims for May must reach the Finance Office by 15 June 2025; later claims are paid in August.",
   "stratum": "natural"
  },
  {
   "id": "4569da2f3b8e",
   "doc_id": "news/bakery_opens.md",
   "chunk_id": "news/bakery_opens.md#0",
   "text": "She trained in Valencia and bakes rye bread and pastries every morning from five.",
   "stratum": "natural"
  },
  {
   "id": "7a4578d0f36b",
   "doc_id": "news/budget_2025.md",
   "chunk_id": "news/budget_2025.md#0",
   "text": "- Station Road drainage: 260,000 pounds",
   "stratum": "natural"
  },
  {
   "id": "619cb649b94b",
   "doc_id": "news/budget_2026.md",
   "chunk_id": "news/budget_2026.md#0",
   "text": "The council has published its works budget for 2026.",
   "stratum": "natural"
  },
  {
   "id": "6db463e1c631",
   "doc_id": "news/budget_2026.md",
   "chunk_id": "news/budget_2026.md#0",
   "text": "- Riverside path lighting: 230,000 pounds",
   "stratum": "natural"
  },
  {
   "id": "29fe5b8838c7",
   "doc_id": "news/council_notices.md",
   "chunk_id": "news/council_notices.md#0",
   "text": "Station Road: lane closures from September while the drainage is rebuilt.",
   "stratum": "cue"
  },
  {
   "id": "b84f7054da3e",
   "doc_id": "news/flood_meeting.md",
   "chunk_id": "news/flood_meeting.md#0",
   "text": "Dr Jonathan Pike of the environmental institute explained how the peat bogs upstream hold back rain and slow the flow into the river.",
   "stratum": "natural"
  },
  {
   "id": "dc9054227c1b",
   "doc_id": "news/flood_meeting.md",
   "chunk_id": "news/flood_meeting.md#0",
   "text": "The council's structural inspector, Daniel Okafor, said the culvert under Station Road is too narrow for heavy storms.",
   "stratum": "natural"
  },
  {
   "id": "13ccb42ae910",
   "doc_id": "news/harbour_open_day.md",
   "chunk_id": "news/harbour_open_day.md#0",
   "text": "# Riverton Water opens its doors",
   "stratum": "natural"
  },
  {
   "id": "eeb4128ff7b9",
   "doc_id": "news/harbour_open_day.md",
   "chunk_id": "news/harbour_open_day.md#0",
   "text": "Technician Rosa Delgado showed them the station's Kestrel V-12 pump and explained how the alarms reach North Station when the site is unmanned.",
   "stratum": "natural"
  },
  {
   "id": "e063b1980590",
   "doc_id": "news/harbour_open_day.md",
   "chunk_id": "news/harbour_open_day.md#0",
   "text": "Children could try a hand pump in the yard, and the café sold out of cakes by noon.",
   "stratum": "natural"
  },
  {
   "id": "a9c4b48a8f4a",
   "doc_id": "news/letter_harbour_street.md",
   "chunk_id": "news/letter_harbour_street.md#0",
   "text": "Sir, the resurfacing of Harbour Street was promised for this year and has now been moved to next year's budget.",
   "stratum": "natural"
  },
  {
   "id": "92f9ab881269",
   "doc_id": "news/letter_to_the_editor.md",
   "chunk_id": "news/letter_to_the_editor.md#0",
   "text": "I cross it every morning with my daughter, and the east railing still moves when you lean on it.",
   "stratum": "cue"
  },
  {
   "id": "fe15ed69cbd0",
   "doc_id": "news/letter_to_the_editor.md",
   "chunk_id": "news/letter_to_the_editor.md#0",
   "text": "Nobody has fixed it, and no warning sign has been put up.",
   "stratum": "natural"
  },
  {
   "id": "7f4d83b98863",
   "doc_id": "news/library_reopened.md",
   "chunk_id": "news/library_reopened.md#0",
   "text": "The contractor finished on 25 August, a week ahead of the deadline.",
   "stratum": "natural"
  },
  {
   "id": "972dc04c241d",
   "doc_id": "news/mill_lane_and_eastgate.md",
   "chunk_id": "news/mill_lane_and_eastgate.md#0",
   "text": "The footbridge will be closed from 3 February while its railings and deck boards are renewed.",
   "stratum": "natural"
  },
  {
   "id": "61f20c0b2113",
   "doc_id": "news/mill_lane_and_eastgate.md",
   "chunk_id": "news/mill_lane_and_eastgate.md#0",
   "text": "Mayor Helen Achterberg said the footbridge \"is safe to use until the works begin\".",
   "stratum": "natural"
  },
  {
   "id": "32db2c49ec43",
   "doc_id": "water/calder_quotation.md",
   "chunk_id": "water/calder_quotation.md#0",
   "text": "Dear Riverton Water,",
   "stratum": "natural"
  },
  {
   "id": "db2c95d2b0c9",
   "doc_id": "water/calder_quotation.md",
   "chunk_id": "water/calder_quotation.md#0",
   "text": "Kind regards,",
   "stratum": "natural"
  },
  {
   "id": "4432ab6b4bc6",
   "doc_id": "water/harbour_station_may_2025.md",
   "chunk_id": "water/harbour_station_may_2025.md#0",
   "text": "# Harbour Station monthly report, May 2025",
   "stratum": "natural"
  },
  {
   "id": "a0a2c56a7f23",
   "doc_id": "water/harbour_station_may_2025.md",
   "chunk_id": "water/harbour_station_may_2025.md#0",
   "text": "The station's only pump, KV12-0457, tripped three times in the first week of May on low suction pressure.",
   "stratum": "cue"
  },
  {
   "id": "35ca17ffb93c",
   "doc_id": "water/harbour_station_may_2025.md",
   "chunk_id": "water/harbour_station_may_2025.md#0",
   "text": "No trip has occurred since.",
   "stratum": "natural"
  },
  {
   "id": "a15a1497d85e",
   "doc_id": "water/harbour_station_may_2025.md",
   "chunk_id": "water/harbour_station_may_2025.md#0",
   "text": "The station was unmanned for the rest of May, with alarms routed to North Station.",
   "stratum": "cue"
  },
  {
   "id": "844d99a7594e",
   "doc_id": "water/incident_2025-03-29.md",
   "chunk_id": "water/incident_2025-03-29.md#0",
   "text": "Flow on the North main dropped to 31 litres per second until HP40-2291 was switched to duty.",
   "stratum": "cue"
  },
  {
   "id": "17df7da23ccf",
   "doc_id": "water/incident_2025-03-29.md",
   "chunk_id": "water/incident_2025-03-29.md#0",
   "text": "Site engineer Tomasz Wren wrote that the flooding would have been avoided had the seal been replaced after the March inspection, as the inspection had recommended.",
   "stratum": "natural"
  },
  {
   "id": "99f62343dd38",
   "doc_id": "water/inspection_2025-03-14.md",
   "chunk_id": "water/inspection_2025-03-14.md#0",
   "text": "Pump HP40-2291 ran quietly.",
   "stratum": "natural"
  },
  {
   "id": "8a5a1c9da433",
   "doc_id": "water/inspection_2025-06-13.md",
   "chunk_id": "water/inspection_2025-06-13.md#0",
   "text": "Technician Rosa Delgado carried out the summer quarterly round on the two Hydra P-40 pumps at North Station.",
   "stratum": "natural"
  },
  {
   "id": "f56c49f39bed",
   "doc_id": "water/inspection_2025-06-13.md",
   "chunk_id": "water/inspection_2025-06-13.md#0",
   "text": "Delgado tagged HP40-2291 for a seal change before the end of the month.",
   "stratum": "natural"
  },
  {
   "id": "219032064259",
   "doc_id": "water/north_station_2024_summary.md",
   "chunk_id": "water/north_station_2024_summary.md#0",
   "text": "# North Station: summary of 2024",
   "stratum": "natural"
  },
  {
   "id": "735b4888d6c9",
   "doc_id": "water/north_station_2024_summary.md",
   "chunk_id": "water/north_station_2024_summary.md#0",
   "text": "No seal failures were recorded in 2024.",
   "stratum": "cue"
  },
  {
   "id": "4b8219f2c4ec",
   "doc_id": "water/north_station_2024_summary.md",
   "chunk_id": "water/north_station_2024_summary.md#0",
   "text": "The only stoppage was a four-hour power cut on 17 November, when both pumps were off.",
   "stratum": "natural"
  },
  {
   "id": "55a608eac08a",
   "doc_id": "water/north_station_2024_summary.md",
   "chunk_id": "water/north_station_2024_summary.md#0",
   "text": "For 2025 the site engineer, Tomasz Wren, plans to share the duty more evenly between the two pumps.",
   "stratum": "natural"
  },
  {
   "id": "bc8a9aa34ecf",
   "doc_id": "water/shift_notes.txt",
   "chunk_id": "water/shift_notes.txt#0",
   "text": "Their service manager, Ines Barros, said the pump had run dry and that the warranty does not cover the seal.",
   "stratum": "natural"
  },
  {
   "id": "c292ec6b562e",
   "doc_id": "water/shift_notes.txt",
   "chunk_id": "water/shift_notes.txt#0",
   "text": "Our log shows the suction valve open for the whole night of the failure, so we do not accept that the pump ran dry.",
   "stratum": "cue"
  },
  {
   "id": "08d476757c8a",
   "doc_id": "water/shift_notes.txt",
   "chunk_id": "water/shift_notes.txt#0",
   "text": "Thu: nothing to report.",
   "stratum": "cue"
  },
  {
   "id": "b2614b4bc061",
   "doc_id": "water/shift_notes_june.txt",
   "chunk_id": "water/shift_notes_june.txt#0",
   "text": "Tue: alarm from Harbour Station at 03:10, cleared remotely; KV12-0457 restarted on its own.",
   "stratum": "natural"
  },
  {
   "id": "c0f8ece9f956",
   "doc_id": "water/shift_notes_june.txt",
   "chunk_id": "water/shift_notes_june.txt#0",
   "text": "Thu: nothing to report.",
   "stratum": "cue"
  },
  {
   "id": "a5b4b46d2f76",
   "doc_id": "water/shift_notes_june.txt",
   "chunk_id": "water/shift_notes_june.txt#0",
   "text": "Fri: quarterly inspection by Rosa Delgado.",
   "stratum": "natural"
  },
  {
   "id": "a2e52b140eb7",
   "doc_id": "water/work_orders_2025-06.md",
   "chunk_id": "water/work_orders_2025-06.md#0",
   "text": "Bearings of HP40-1183 regreased by Rosa Delgado.",
   "stratum": "natural"
  }
 ]
}