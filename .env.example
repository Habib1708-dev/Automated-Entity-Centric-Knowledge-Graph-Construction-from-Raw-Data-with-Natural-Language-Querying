# Model preset from presets.yaml: smoke ($0, local Ollama, checks the code), dev (cents, flash-lite),
# quality (the runs you report). The preset replaces the model lines below; see README.
KG_PRESET=dev
# Without a preset: gemini (default) or ollama, and the *_MODEL lines below name the models
# LLM_PROVIDER=gemini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_NUM_CTX=16384
GEMINI_API_KEY=
# Any Gemini model ids. Flash for both keeps development runs cheap; for runs whose results are
# reported, use the stronger model for schema work: SCHEMA_MODEL=gemini-3.1-pro-preview
SCHEMA_MODEL=gemini-3.8-flash
EXTRACT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password123

# Optional tuning (defaults shown). Every one of these is logged as an MLflow param by the stage it affects.
# LLM_TEMPERATURE=0.0
# LLM_MAX_ATTEMPTS=3
# EXTRACT_WORKERS=8
# CHUNK_MAX_CHARS=1500
# CHUNK_MIN_CHARS=200
# CHUNK_OVERLAP_CHARS=0
# ER_AUTO_MERGE=92.0
# ER_BORDERLINE=80.0
# ER_EMBEDDING_CANDIDATES=0.0
# DOMAIN_LINK_THRESHOLD=90.0
# GOLD_MIN_RECALL=0.5
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLFLOW_EXPERIMENT=kgbuilder
